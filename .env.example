# Copy to .env and fill in to enable live document extraction.
# Without this, submissions that don't use pre_extracted_data fixtures will
# be gracefully routed to NEEDS_MEMBER_ACTION / MANUAL_REVIEW instead of
# crashing -- see src/core/llm.py.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
