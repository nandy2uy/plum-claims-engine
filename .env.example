# Copy to .env. Nothing here is required to run the tests or the 12 eval cases.

# Live document reading (uploads through the UI / multipart API). Without a key,
# uploaded claims are routed to MANUAL_REVIEW (EXTRACTION_INCOMPLETE) — never blamed on the member.
# Both providers are called through the OpenAI-compatible API, so only these lines change.
# Provider: gemini or openai.
LLM_PROVIDER=gemini
# Gemini key from Google AI Studio.
GEMINI_API_KEY=
# Only needed if LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Leave empty for the provider default (gemini-3.8-flash / gpt-4o-mini). Check AI Studio for current names.
LLM_MODEL=
# Leave empty for the provider default endpoint.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4

# Stage budgets (seconds)
EXTRACTION_STAGE_TIMEOUT_SECONDS=120
STAGE_TIMEOUT_SECONDS=10

# Upload limits
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5

# Accept DocumentSource.pre_extracted_data on POST /api/v1/claims (fixture mode, used by the
# README curl example and scripts/run_evals.py --url). Keep OFF in production: a caller could
# otherwise skip extraction and submit invented amounts and diagnoses. The UI's test-case runner
# works either way because it uses the server's own fixtures.
ALLOW_FIXTURE_DOCUMENTS=true

# Lets a request force a component to fail (TC011). Enable for local demos only:
# in production it would let a caller switch off checks on their own claim.
ALLOW_FAULT_INJECTION=true
